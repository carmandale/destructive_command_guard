 expected = "deny"
+
+# ============================================================================
+# Not the delimiter either: sort is not a data sink at any quoting
+#
+# .agent-config-slwtp removed sort from NON_EXECUTING_HEREDOC_COMMANDS because
+# `sort --compress-program=PROG` pipes its spilled temp data to PROG's stdin,
+# and `-S` in the same argv lets the writer force the spill. The stock BSD sort
+# accepts the flag and spawns it. This row sat in heredoc_data.toml as `allow`
+# until the removal turned it red; the verdict moved, not the command.
+# ============================================================================
+
+[[case]]
+description = "sort heredoc is not data even with a quoted delimiter — sort can pipe its stdin to a program"
+command = "sort <<'EOF'\nrm -rf /\ngit clean -fd\nEOF"
+expected = "deny"
